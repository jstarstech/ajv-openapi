{
  "name": "@jstarstech/ajv-openapi",
  "version": "3.0.4",
  "description": "Ajv plugin to add OpenAPI v3 data type formats support",
  "author": "Touchify <dev@touchify.co>",
  "license": "MIT",
  "main": "index.js",
  "homepage": "https://github.com/jstarstech/ajv-openapi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jstarstech/ajv-openapi.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "scripts": {
    "build": "npm run clean && npm run lint && npm run build:ts",
    "build:ts": "tsc -p .",
    "test": "npm run clean && npm run lint && npm run test:jest",
    "test:jest": "jest",
    "test:coverage": "npm run test -- -- --coverage",
    "test:ci": "npm run test:coverage -- --ci",
    "lint": "npm run lint:ts",
    "lint:ts": "eslint --ext .ts *.ts lib/**/*.ts tests/**/*.ts",
    "clean": "npm run clean:ts",
    "clean:ts": "rimraf --glob index.js index.d.ts \"lib/**/*.js\" \"lib/**/*.d.ts\"",
    "preversion": "npm run lint",
    "postversion": "git push && git push --tags",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "ajv": "^8.20.0",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "testMatch": [
      "**/tests/**/*.spec.ts"
    ]
  },
  "bugs": {
    "url": "https://github.com/jstarstech/ajv-openapi/issues"
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  }
}